# =============================================================================
# PoggioAI/MSc LLM Configuration — CLI Agent Mode
# =============================================================================
# Copy this file to .llm_config.yaml and customize:
#   cp .llm_config.yaml.example .llm_config.yaml
#
# Agents run as local CLI tool subprocesses (Claude Code, Codex, Gemini CLI)
# instead of making API calls. Much cheaper with subscription plans.
#
# Requirements:
#   - For Claude: `claude` CLI installed (Claude Code)
#   - For Codex: `codex` CLI installed (OpenAI Codex)
#   - For Gemini: `gemini` CLI installed (Google Gemini CLI)

# --- Default CLI backend ---
default_backend: claude              # claude | codex | gemini
default_model: claude-opus-4-6     # model flag passed to the CLI tool
timeout_seconds: 3600                # max wall-clock seconds per agent invocation

# --- Budget enforcement (invocation / wall-clock based) ---
budget:
  max_invocations: 100               # max total CLI agent calls
  max_wall_clock_seconds: 14400      # max total subprocess time (4h)

# --- Per-agent backend overrides (optional) ---
# Assign different CLI backends or models to specific agents.
# agent_backends:
#   math_prover_agent:
#     backend: claude
#     model: claude-opus-4-6
#     timeout_seconds: 7200
#   experimentation_agent:
#     backend: codex
#     model: gpt-5.4
#   math_literature_agent:
#     backend: gemini
#     model: gemini-3.1-pro-preview

# --- Counsel mode (multi-model debate per agent stage) ---
# counsel:
#   max_debate_rounds: 3
#   specs:
#     - model: claude-opus-4-6
#       backend: claude
#     - model: gpt-5.4
#       backend: codex
#     - model: gemini-3.1-pro-preview
#       backend: gemini

# --- Persona council (V2 pipeline) ---
persona_council:
  max_debate_rounds: 3
  synthesis_model: claude-opus-4-6

# --- Duality check model ---
duality_check:
  model: claude-opus-4-6
